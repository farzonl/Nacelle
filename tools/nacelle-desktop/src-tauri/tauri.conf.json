{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nacelle Profile Viewer",
  "version": "0.1.0",
  "identifier": "dev.nacelle.profile-viewer",
  "build": {
    "frontendDist": "../dist-viewer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["main-capability"],
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'nonce-nacelle-editor'; style-src-attr 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}

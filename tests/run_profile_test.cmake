file(REMOVE "${PROFILE}" "${PROFILE}.warmup")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef cache_suffix)
set(ENV{NACELLE_CACHE_DIR} "${PROFILE}.cache-${cache_suffix}")
if(CAPTURE_MODE STREQUAL "tier1")
    set(ENV{NACELLE_DISABLE_TIER2} "1")
else()
    set(ENV{NACELLE_DISABLE_TIER2} "0")
endif()
if(CAPTURE_MODE STREQUAL "disk")
    execute_process(COMMAND "${PROGRAM}" "${PROFILE}.warmup" all RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Runtime profile cache warmup failed: ${result}")
    endif()
endif()
execute_process(COMMAND "${PROGRAM}" "${PROFILE}" ${CAPTURE_MODE} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Runtime profile test failed: ${result}")
endif()

// RUN: %dxc -T cs_6_0 -E CSMain -Fo %t.dxil %S/../shaders/vec_add.hlsl
// RUN: %nacelle_compile --simd-width=4 --emit-simd-mlir %t.dxil | %FileCheck %s --check-prefix=W4
// RUN: %nacelle_compile --simd-width=8 --emit-simd-mlir %t.dxil | %FileCheck %s --check-prefix=W8
// RUN: %nacelle_compile --simd-width=16 --emit-simd-mlir %t.dxil | %FileCheck %s --check-prefix=W16
// RUN: %nacelle_compile --simd-width=4 --emit-llvm %t.dxil | %FileCheck %s --check-prefix=LLVM

// W4: func.func @nacelle_cs_test
// W4: vector<4x
// W4: llvm.intr.masked.load{{.*}}vector<4xf32>
// W4: llvm.intr.masked.gather{{.*}}vector<4xf32>
// W4: arith.addf{{.*}}vector<4xf32>
// W4: llvm.intr.masked.store{{.*}}vector<4xf32>
// W4: llvm.intr.masked.scatter{{.*}}vector<4xf32>

// W8: func.func @nacelle_cs_test
// W8: vector<8x
// W8: llvm.intr.masked.load{{.*}}vector<8xf32>
// W8: llvm.intr.masked.gather{{.*}}vector<8xf32>
// W8: arith.addf{{.*}}vector<8xf32>
// W8: llvm.intr.masked.store{{.*}}vector<8xf32>
// W8: llvm.intr.masked.scatter{{.*}}vector<8xf32>

// W16: func.func @nacelle_cs_test
// W16: vector<16x
// W16: llvm.intr.masked.load{{.*}}vector<16xf32>
// W16: llvm.intr.masked.gather{{.*}}vector<16xf32>
// W16: arith.addf{{.*}}vector<16xf32>
// W16: llvm.intr.masked.store{{.*}}vector<16xf32>
// W16: llvm.intr.masked.scatter{{.*}}vector<16xf32>

// LLVM: define void @nacelle_cs_test(ptr noalias readonly %0, ptr %1,
// LLVM: load {{.*}}, !invariant.load !
